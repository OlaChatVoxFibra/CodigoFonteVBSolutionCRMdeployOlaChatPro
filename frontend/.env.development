# Desliga o ESLint no bundle de desenvolvimento (evita overlay "Plugin react was conflicted"
# no Windows quando o disco expõe o mesmo caminho com caixa diferente).
# Lint no editor: use .eslintrc.js. Para voltar o lint no webpack, comente a linha abaixo
# e use o patch useEslintrc em craco.config.js.
DISABLE_ESLINT_PLUGIN=true
PORT=5181

# API + Socket.IO: mesma origem que o backend (PORT por defeito 3000 — ver backend/.env e `npm run dev` no backend).
REACT_APP_BACKEND_URL=http://localhost:3000
