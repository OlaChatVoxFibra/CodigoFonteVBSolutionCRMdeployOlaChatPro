PORT=5181
# Dev local (frontend na 5181, API na 3000 — `npm start` ou `npm run dev` no frontend)
REACT_APP_BACKEND_URL=http://localhost:3000
# Produção: REACT_APP_BACKEND_URL=https://back.seudominio.com.br
# Meta (Facebook / Instagram): fallback global da plataforma (opcional).
# Por organização, configure em Conexões → WhatsApp API Oficial (campos no painel).
REACT_APP_FACEBOOK_APP_ID=
# REACT_APP_META_WHATSAPP_EMBEDDED_CONFIG_ID=
REACT_APP_NAME_SYSTEM=
REACT_APP_NUMBER_SUPPORT=
# TRUE = adiciona business_management ao login Meta (Página + Instagram)
REACT_APP_REQUIRE_BUSINESS_MANAGEMENT=TRUE
# Escopos OAuth: frontend/src/config/metaOAuthScopes.js (pages_messaging, human_agent, instagram_business_*)

GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
BUILD_PATH=build
CI=false

# Desabilitar análises desnecessárias em produção
ESLint_NO_DEV_ERRORS=true
TSC_COMPILE_ON_ERROR=true

# Otimizações específicas do CRA
FAST_REFRESH=false