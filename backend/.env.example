# =============================================================================
# VB Solution CRM — Backend (.env)
# Visão Business — copie para backend/.env e preencha com SEUS valores
# =============================================================================

NODE_ENV=development
BACKEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5181
# WEB_ORIGIN=http://localhost:5181
PROXY_PORT=8080
PORT=3000

# PostgreSQL — banco PRÓPRIO do comprador (sem vínculo com ambientes antigos)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASS=password
DB_NAME=database
DB_SSL=false
DB_POOL_MAX=8
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
# DATABASE_URL=postgresql://user:password@localhost:5432/database

JWT_SECRET=
JWT_REFRESH_SECRET=

REDIS_URI=redis://default:password@localhost:6379
REDIS_URI_ACK=redis://default:password@localhost:6379
REDIS_URL=redis://default:password@localhost:6379
REDIS_PUBLIC_URL=redis://default:password@localhost:6379
REDIS_PRIVATE_URL=redis://default:password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=password
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

SOCKET_ADMIN=true
USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

# Meta (Facebook / Instagram / WhatsApp Cloud API) — credenciais do cliente
VERIFY_TOKEN=vbsolution
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# META_WHATSAPP_EMBEDDED_CONFIG_ID=

USE_WHATSAPP_OFICIAL=true
# URL_API_OFICIAL=
# TOKEN_API_OFICIAL=

TRANSCRIBE_URL=

# Pagamentos — Stripe (chaves do comprador)
STRIPE_PRIVATE=
STRIPE_SECRET_KEY=
STRIPE_MODE=test
STRIPE_WEBHOOK_SECRET=
STRIPE_OK_URL=http://localhost:5181/payment/success
STRIPE_CANCEL_URL=http://localhost:5181/payment/cancel
STRIPE_PRICE_STARTER_BRL_MONTHLY=
STRIPE_PRICE_STARTER_BRL_ANNUAL=
PAYMENT_LINK_STARTER_BRL_MONTHLY=
PAYMENT_LINK_STARTER_BRL_ANNUAL=
STRIPE_PRICE_ONBOARDING_BRL=
STRIPE_PRICE_ONBOARDING_USD=
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=
ASAAS_TOKEN=
GERENCIANET_SANDBOX=
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_PIX_CERT=
GERENCIANET_PIX_KEY=
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_TOKEN=

# Runtime do agente (sem chaves embutidas)
OPENAI_RESPONSES_RUNTIME_ENABLED=true
AGENT_LLM_FIRST_RUNTIME_ENABLED=true
AI_INBOUND_QUEUE_ENABLED=false
AGENT_FILE_SEARCH_ENABLED=false
AGENT_OPENAI_KNOWLEDGE_INDEXING=true

# IA — preferir API Key por empresa no painel (OpenAI / Claude / Gemini)
ANTHROPIC_API_KEY=
ANTHROPIC_KEY_ENCRYPTION_SECRET=
GEMINI_KEY_ENCRYPTION_SECRET=
GROK_KEY_ENCRYPTION_SECRET=
FIGMA_KEY_ENCRYPTION_SECRET=

# Google Login OAuth (opcional — autenticação; Calendar/Sheets removidos)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# GitHub OAuth (Brain.AI — opcional)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Brain — deixe vazio; cliente usa as próprias chaves no painel
BRAIN_PLATFORM_OPENAI_API_KEY=
BRAIN_PLATFORM_ANTHROPIC_API_KEY=
BRAIN_PLATFORM_GEMINI_API_KEY=
BRAIN_PLATFORM_XAI_API_KEY=

# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_FORCE_POLLING=true
# CHROME_PATH=

# -----------------------------------------------------------------------------
# Modo local SEM banco (desenvolvimento / demo do codigo-fonte)
# Nunca ative em production. Login: DEV_AUTH_EMAIL / DEV_AUTH_PASSWORD
# -----------------------------------------------------------------------------
DEV_NO_DB=true
DEV_AUTH_EMAIL=admin@local.dev
DEV_AUTH_PASSWORD=123456