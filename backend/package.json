  "scripts": {
    "build": "node node_modules/typescript/bin/tsc --skipLibCheck",
    "watch": "tsc -w",
    "dev": "npm run dev:server",
    "start": "node scripts/prepare-and-migrate.js && node dist/server.js",
    "start:migrate": "node scripts/prepare-and-migrate.js && node dist/server.js",
    "migrate:build": "npm run build && node scripts/prepare-and-migrate.js",
    "dev:server": "nodemon --delay 3 --watch src --ext ts,js --exec \"node -r ts-node/register/transpile-only src/server.ts\"",
    "db:migrate": "node scripts/prepare-and-migrate.js",
    "db:seed": "node node_modules/sequelize-cli/lib/sequelize db:seed:all",
