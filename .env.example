# =============================================================================
# OlaChat Pro
# Exemplo de variáveis de ambiente (SEM valores reais / SEM segredos)
# Copie para backend/.env e frontend/.env.development conforme a pasta.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (frontend/.env.development ou frontend/.env)
# -----------------------------------------------------------------------------
PORT=5181
REACT_APP_BACKEND_URL=http://localhost:3000
REACT_APP_FACEBOOK_APP_ID=
# REACT_APP_META_WHATSAPP_EMBEDDED_CONFIG_ID=
REACT_APP_NAME_SYSTEM=OlaChat Pro
REACT_APP_NUMBER_SUPPORT=
REACT_APP_REQUIRE_BUSINESS_MANAGEMENT=TRUE
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false
BUILD_PATH=build
CI=false
ESLint_NO_DEV_ERRORS=true
TSC_COMPILE_ON_ERROR=true
FAST_REFRESH=false
DISABLE_ESLINT_PLUGIN=true

# -----------------------------------------------------------------------------
# BACKEND — aplicação
# -----------------------------------------------------------------------------
NODE_ENV=development
BACKEND_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5181
# WEB_ORIGIN=http://localhost:5181
PROXY_PORT=8080
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL (obrigatório — use seu próprio banco; sem vínculo com DB antigo)
# Prefira DB_* local. DATABASE_URL é opcional no seu host.
# -----------------------------------------------------------------------------
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL=false
DB_POOL_MAX=8
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# -----------------------------------------------------------------------------
# JWT (gere valores novos e únicos — nunca reutilize exemplos públicos)
# openssl rand -base64 32
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------------
# Redis (filas Bull, campanhas, agente — recomendado)
# -----------------------------------------------------------------------------
REDIS_URI=redis://default:PASSWORD@localhost:6379
REDIS_URI_ACK=redis://default:PASSWORD@localhost:6379
REDIS_URL=redis://default:PASSWORD@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000

SOCKET_ADMIN=true
USER_LIMIT=10000
CONNECTIONS_LIMIT=100000
CLOSED_SEND_BY_ME=true

# -----------------------------------------------------------------------------
# Meta / WhatsApp (Cloud API Oficial)
# Credenciais do APP Meta do cliente — não use chaves da Visão Business
# -----------------------------------------------------------------------------
VERIFY_TOKEN=vbsolution
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# META_WHATSAPP_EMBEDDED_CONFIG_ID=
USE_WHATSAPP_OFICIAL=true
# URL_API_OFICIAL=
# TOKEN_API_OFICIAL=

TRANSCRIBE_URL=

# -----------------------------------------------------------------------------
# E-mail / SMTP (opcional — também configurável por empresa no painel)
# -----------------------------------------------------------------------------
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASS=
# MAIL_SECURE=
# MAIL_FROM=
# EMAIL_SMTP_RELAY_URL=
# EMAIL_SMTP_RELAY_SECRET=

# -----------------------------------------------------------------------------
# Pagamentos — Stripe e opcionais (chaves do comprador)
# -----------------------------------------------------------------------------
STRIPE_PRIVATE=
STRIPE_SECRET_KEY=
STRIPE_MODE=test
STRIPE_WEBHOOK_SECRET=
STRIPE_OK_URL=http://localhost:5181/payment/success
STRIPE_CANCEL_URL=http://localhost:5181/payment/cancel
STRIPE_PRICE_STARTER_BRL_MONTHLY=
STRIPE_PRICE_STARTER_BRL_ANNUAL=
PAYMENT_LINK_STARTER_BRL_MONTHLY=
PAYMENT_LINK_STARTER_BRL_ANNUAL=
STRIPE_PRICE_ONBOARDING_BRL=
STRIPE_PRICE_ONBOARDING_USD=
MP_ACCESS_TOKEN=
MP_NOTIFICATION_URL=
ASAAS_TOKEN=
GERENCIANET_SANDBOX=
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_PIX_CERT=
GERENCIANET_PIX_KEY=
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
CAKTO_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Inteligência Artificial — estrutura apenas
# NÃO coloque chaves da Visão Business. O cliente configura no painel
# (OpenAI / Anthropic / Gemini por organização) ou, se necessário, abaixo.
# -----------------------------------------------------------------------------
# OPENAI_DEFAULT_CHAT_MODEL=
# OPENAI_DEFAULT_FAST_MODEL=
OPENAI_RESPONSES_RUNTIME_ENABLED=true
AGENT_LLM_FIRST_RUNTIME_ENABLED=true
AI_INBOUND_QUEUE_ENABLED=false
AGENT_FILE_SEARCH_ENABLED=false
AGENT_OPENAI_KNOWLEDGE_INDEXING=true

# Legado / opcional — preferir chave por empresa no painel
ANTHROPIC_API_KEY=
ANTHROPIC_KEY_ENCRYPTION_SECRET=
GEMINI_KEY_ENCRYPTION_SECRET=
GROK_KEY_ENCRYPTION_SECRET=
FIGMA_KEY_ENCRYPTION_SECRET=

# Plataforma Brain (opcional). Deixe vazio — o cliente usa as próprias chaves.
BRAIN_PLATFORM_OPENAI_API_KEY=
BRAIN_PLATFORM_ANTHROPIC_API_KEY=
BRAIN_PLATFORM_GEMINI_API_KEY=
BRAIN_PLATFORM_XAI_API_KEY=

# -----------------------------------------------------------------------------
# Google Login (OAuth de autenticação — opcional)
# NÃO confundir com Google Calendar/Sheets (removidos deste pacote)
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=

# -----------------------------------------------------------------------------
# GitHub OAuth (Brain.AI — publicar código no IDE — opcional)
# -----------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=

# -----------------------------------------------------------------------------
# Telegram / outros canais (opcional)
# -----------------------------------------------------------------------------
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_FORCE_POLLING=true
# TELEGRAM_DISABLE_POLLING=true

# -----------------------------------------------------------------------------
# Criptografia de tokens em repouso (gere com openssl rand -base64 32)
# -----------------------------------------------------------------------------
# INTEGRATION_TOKEN_ENCRYPTION_SECRET=

# -----------------------------------------------------------------------------
# Chrome / Puppeteer (exportações Brain — opcional)
# -----------------------------------------------------------------------------
# CHROME_PATH=
# BRAIN_ALLOW_REMOTE_TERMINAL=false
# BRAIN_LOCAL_TERMINAL_URL=http://127.0.0.1:9333

DEV_NO_DB=true
DEV_AUTH_EMAIL=admin@local.dev
DEV_AUTH_PASSWORD=admin123

